      "allowed_arguments": {
        "repository": [
          "ai"
        ],
        "relative_path": [
          "config/settings.py"
        ]
      },
      "expected_tool": "workspace_read_text",
      "expected_arguments": {
        "repository": "ai",
        "relative_path": "config/settings.py"
