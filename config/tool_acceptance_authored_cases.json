      "user": "Assign asset AST-204 to employee user-482.",
      "allowed_tools": ["asset_assign"],
      "allowed_arguments": {"asset_id": ["AST-204"], "user_id": ["user-482"]},
      "expected_tool": "asset_assign",
      "expected_arguments": {"asset_id": "AST-204", "user_id": "user-482"}
    },
    {
      "id": "asset-unassign-exact-target",
