{
  "schema": "tool-proposal-cases.v1",
  "review_status": "authored_unreviewed",
  "description": "Deliberately authored synthetic proposal targets. These are test expectations, never production routing rules, live resources, or passing acceptance evidence. Review and real adapter generation remain required.",
  "cases": [
    {
      "id": "mailbox-create-explicit-local-email",
      "agent": "account-specialist",
      "user": "Create a local SMTP/IMAP mailbox for itsm.fixture@itsm.test. Generate its password only after approval and keep it encrypted.",
      "allowed_tools": ["mailbox_create"],
      "allowed_arguments": {"email": ["itsm.fixture@itsm.test"]},
      "expected_tool": "mailbox_create",
      "expected_arguments": {"email": "itsm.fixture@itsm.test"}
    },
    {
      "id": "mailbox-status-explicit-local-email",
      "agent": "account-specialist",
      "user": "Check whether local mailbox credentials and IMAP storage exist for itsm.fixture@itsm.test. Do not create an account or send email.",
      "allowed_tools": ["mailbox_status"],
      "allowed_arguments": {"email": ["itsm.fixture@itsm.test"]},
      "expected_tool": "mailbox_status",
      "expected_arguments": {"email": "itsm.fixture@itsm.test"}
    },
    {
