# Deployment configuration only. Copy to an ignored private file and supply it
# with --env-file. Never place provider credentials or model JSON in this file.
COMPOSE_PROJECT_NAME=janus
AGENTIC_CONTEXT=..
BACKEND_CONTEXT=../../../agenticBackend/itsm_backend
FRONTEND_CONTEXT=../../../agenticFrontend

# Exact reviewed image digests are recommended. These values intentionally have
# no registry defaults: choose compatible images for your platform.
PYTHON_RUNTIME_IMAGE=
ELIXIR_BUILD_IMAGE=
DEBIAN_RUNTIME_IMAGE=
NIM_BUILD_IMAGE=
NGINX_RUNTIME_IMAGE=
SURREALDB_IMAGE=
AGENTIC_IMAGE=agentic:local
BACKEND_IMAGE=backend:local
FRONTEND_IMAGE=frontend:local

# PUBLIC_ORIGIN is the browser's real origin, e.g. https://itsm.example:8443.
# PUBLIC_HOST must match its hostname and the trusted certificate's SAN.
PUBLIC_HOST=
PUBLIC_ORIGIN=
# 127.0.0.1 keeps it on this machine. For other machines, use the address users
# reach: a VPN address (Tailscale/WireGuard), the LAN address a port forward
# targets, or a cloud server's private address. See "Reaching it from other machines".
PUBLIC_BIND_IP=127.0.0.1
PUBLIC_TLS_PORT=8443
# Only behind a port forward or load balancer that rewrites the source address:
# its address or range, comma separated. Empty trusts no proxy.
EDGE_TRUSTED_PROXIES=

# Use private files described by the companion *.env.example files.
AGENTIC_ENV_FILE=./private/agentic.env
BACKEND_ENV_FILE=./private/backend.env
DATABASE_ENV_FILE=./private/database.env
TLS_CERT_FILE=./private/tls.crt
TLS_KEY_FILE=./private/tls.key
# Optional compose.trust.yaml for a reviewed private CA. Include normal public
# roots in the supplied bundle; no client disables certificate verification.
TLS_CA_BUNDLE_FILE=

# Existing, dedicated directories; Compose never creates these implicitly.
# Model profile JSON must use /models/... paths inside the AI container.
MODELS_ROOT=
WORKSPACE_ROOT=
DATABASE_DATA_ROOT=./state/database
AGENTIC_STATE_ROOT=./state/ai

# Optional compose.profile.yaml overlay. This directory contains machine.lua
# and reviewed .lua plugin files only; keep credentials in the separate file.
LUA_PROFILE_ROOT=
LUA_PROFILE_SHA256=
LUA_LINK_SECRETS_FILE=
