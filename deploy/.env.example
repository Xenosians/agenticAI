# Deployment configuration only. Copy to an ignored private file and supply it
# with --env-file. Never place provider credentials or model JSON in this file.
COMPOSE_PROJECT_NAME=janus
AI_CONTEXT=..
BACKEND_CONTEXT=../../../agenticBackend/itsm_backend
FRONTEND_CONTEXT=../../../agenticFrontend

# Exact reviewed image digests are recommended. These values intentionally have
# no registry defaults: choose compatible images for your platform.
PYTHON_RUNTIME_IMAGE=
ELIXIR_BUILD_IMAGE=
DEBIAN_RUNTIME_IMAGE=
NIM_BUILD_IMAGE=
NGINX_RUNTIME_IMAGE=
SURREALDB_IMAGE=
AI_IMAGE=janus-ai:local
BACKEND_IMAGE=janus-backend:local
FRONTEND_IMAGE=janus-frontend:local

# PUBLIC_ORIGIN is the browser's real origin, e.g. https://itsm.example:8443.
# PUBLIC_HOST must match its hostname and the trusted certificate's SAN.
PUBLIC_HOST=
PUBLIC_ORIGIN=
PUBLIC_BIND_IP=127.0.0.1
PUBLIC_TLS_PORT=8443

# Use private files described by the companion *.env.example files.
AI_ENV_FILE=./private/ai.env
BACKEND_ENV_FILE=./private/backend.env
DATABASE_ENV_FILE=./private/database.env
TLS_CERT_FILE=./private/tls.crt
TLS_KEY_FILE=./private/tls.key

# Existing, dedicated directories; Compose never creates these implicitly.
# Model profile JSON must use /models/... paths inside the AI container.
MODELS_ROOT=
WORKSPACE_ROOT=
DATABASE_DATA_ROOT=./state/database
AI_STATE_ROOT=./state/ai
