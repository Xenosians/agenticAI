# ============================================================
# DIRECTORY BACKEND
# ============================================================

# mock | ldap
DIRECTORY_BACKEND=mock


# ============================================================
# LOCAL SAMBA AD DEVELOPMENT SETTINGS
# ============================================================

SAMBA_DOMAIN=ITSM
SAMBA_REALM=itsm.local
SAMBA_NETBIOS=ITSMDC

# Set a strong local-development password.
# Never commit the real value.
SAMBA_ADMIN_PASS=change-me


# ============================================================
# LDAP / ACTIVE DIRECTORY
# ============================================================

AD_HOST=127.0.0.1
AD_PORT=1636
AD_USE_SSL=true

AD_BASE_DN=DC=itsm,DC=local

# Read-only service account.
# AD_BIND_USER may be used instead of AD_BIND_DN.
AD_BIND_DN=CN=svc_itsm_reader,CN=Users,DC=itsm,DC=local
AD_BIND_PASSWORD=change-me

# Separate service account for approved mutations.
# AD_WRITE_BIND_USER may be used instead of AD_WRITE_BIND_DN.
AD_WRITE_BIND_DN=CN=svc_itsm_writer,CN=Users,DC=itsm,DC=local
AD_WRITE_BIND_PASSWORD=change-me

# User used by scripts/ldap_preflight.py
AD_TEST_USER=jdoe

# Map logical resources to AD groups.
AD_ACCESS_GROUPS={"vpn":"VPN-Users","admin":"ITSM-Admins"}
