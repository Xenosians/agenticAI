# Backend
DIRECTORY_BACKEND=mock

# Active Directory
AD_HOST=dc01.example.local
AD_PORT=636
AD_USE_SSL=true

AD_BIND_USER=service-account@example.local
AD_BIND_PASSWORD=CHANGE_ME

AD_BASE_DN=DC=example,DC=local

# Resource → AD group mapping
AD_ACCESS_GROUPS={"vpn":"VPN-Users","admin":"Domain Admins"}

# Safe account used only for integration testing
AD_TEST_USER=testuser