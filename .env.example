# ============================================================
# ITSM Agent
#
# Canonical environment template.
#
# Copy this file to .env and provide environment-specific
# values there.
#
# Never commit real credentials or deployment-specific secrets.
# ============================================================


# ============================================================
# AI SERVICE
# ============================================================

AI_HOST=127.0.0.1
AI_PORT=8000


# ============================================================
# PHOENIX CALLBACK TRANSPORT
# ============================================================

PHOENIX_BASE_URL=http://127.0.0.1:4000

# Must match the Phoenix ITSM_INTERNAL_JOB_TOKEN.
ITSM_INTERNAL_JOB_TOKEN=

PHOENIX_HTTP_TIMEOUT_SECONDS=10


# ============================================================
# DURABLE COMPLETION OUTBOX
# ============================================================

COMPLETION_OUTBOX_PATH=.runtime/completion_outbox.sqlite3

OUTBOX_RETRY_SECONDS=5
OUTBOX_BATCH_SIZE=100


# ============================================================
# DURABLE APPROVAL STORE
# ============================================================

APPROVAL_STORE_PATH=.runtime/approvals.sqlite3


# ============================================================
# PROCESS EXECUTION WORKSPACE
#
# Defaults to the AI repository root when omitted.
# ============================================================

# PROCESS_WORKSPACE_ROOT=/path/to/approved/workspace


# ============================================================
# AGENT DEFINITIONS
# ============================================================

AGENTS_DIR=./subagents/agents


# ============================================================
# MAIN HUB
# ============================================================

HUB_BACKEND=ministral

HUB_MODEL_PATH=/path/to/Ministral-3-3B-Instruct-2512

# Required on GPUs such as RTX 4050 / compute capability 8.9.
HUB_DEQUANTIZE_FP8=true

# Optional disk-offload directory.
# HUB_OFFLOAD_FOLDER=/path/to/offload


# ============================================================
# SPECIALIST WORKER MODELS
#
# Logical model key -> backend/path/enabled configuration.
#
# Agent definition files reference these logical keys through
# their YAML front-matter `model:` value.
#
# Adding another specialist model requires only adding another
# entry here and referencing its key from an agent definition.
# ============================================================

WORKER_MODELS='{"qwen2.5-0.5b-funccall":{"backend":"qwen-funccall","model_path":"/path/to/qwen2.5-0.5b-funccall","enabled":true},"qwen3-0.6b":{"backend":"qwen3","model_path":"/path/to/Qwen3-0.6B","enabled":true},"qwen2.5-coder-0.5b":{"backend":"qwen-coder","model_path":"/path/to/Qwen2.5-Coder-0.5B-Instruct","enabled":true}}'


# ============================================================
# DIRECTORY PROVIDER
# ============================================================

# mock | ldap
DIRECTORY_BACKEND=mock


# ============================================================
# LOCAL SAMBA AD DEVELOPMENT
# ============================================================

SAMBA_DOMAIN=ITSM
SAMBA_REALM=itsm.local
SAMBA_NETBIOS=ITSMDC

# Supply a local-development password in .env.
SAMBA_ADMIN_PASS=


# ============================================================
# LDAP / ACTIVE DIRECTORY
# ============================================================

AD_HOST=127.0.0.1
AD_PORT=1636
AD_USE_SSL=true

AD_BASE_DN=DC=itsm,DC=local


# ------------------------------------------------------------
# READ-ONLY BIND
# ------------------------------------------------------------

AD_BIND_USER=
AD_BIND_DN=
AD_BIND_PASSWORD=


# ------------------------------------------------------------
# WRITE / MUTATION BIND
# ------------------------------------------------------------

AD_WRITE_BIND_USER=
AD_WRITE_BIND_DN=
AD_WRITE_BIND_PASSWORD=


# ------------------------------------------------------------
# LOCAL / INTEGRATION TEST IDENTITY
# ------------------------------------------------------------

AD_TEST_USER=jdoe


# ------------------------------------------------------------
# LOGICAL RESOURCE -> AD GROUP MAPPING
# ------------------------------------------------------------

AD_ACCESS_GROUPS='{"vpn":"VPN-Users","admin":"ITSM-Admins"}'