# ============================================================
# LEARNING / TRAJECTORY CAPTURE
#
# Raw trajectories are sanitized before persistence.
# Raw capture does not automatically make records eligible for
# model training.
# ============================================================

LEARNING_CAPTURE_ENABLED=false
LEARNING_TRAJECTORY_PATH=.runtime/learning/trajectories.jsonl
# ============================================================
# MODEL FLEET RESIDENCY
#
# HUB_MODEL_KEY is always pinned by ModelManager. Additional
# model keys may be pinned here when a deployment needs them.
# ============================================================

MODEL_MAX_LOADED_MODELS=2
MODEL_PINNED_KEYS=[]

# MODEL_PROFILES is deployment-specific because local model paths
# differ by machine. The model-fleet installer can add a jira-func
# hf-causal candidate profile to an existing local .env without
# replacing any credentials or unrelated settings.

# Corporate account identity policy (optional domain override).
# If ACCOUNT_EMAIL_DOMAIN is omitted, LDAP deployments derive it from AD_BASE_DN.
ACCOUNT_EMAIL_DOMAIN=
AD_ACCOUNT_CONTAINER_DN=
ACCOUNT_TEMPORARY_PASSWORD_LENGTH=24
