# ============================================================
# ITSM Agent
# ============================================================

# Python AI service
AI_HOST=127.0.0.1
AI_PORT=8000


# Agent definitions
AGENTS_DIR=./subagents/agents


# ============================================================
# Hub
# ============================================================

HUB_BACKEND=ministral

HUB_MODEL_PATH=/path/to/Ministral-3-3B-Instruct-2512

# Required on GPUs such as RTX 4050 / compute capability 8.9.
HUB_DEQUANTIZE_FP8=true


# ============================================================
# Account worker
# ============================================================

ACCOUNT_BACKEND=qwen-funccall
ACCOUNT_MODEL_KEY=qwen2.5-0.5b-funccall
ACCOUNT_MODEL_PATH=/path/to/qwen2.5-0.5b-funccall


# ============================================================
# Access worker
# ============================================================

# Keep disabled until its Qwen checkpoint passes testing.
ACCESS_ENABLED=false

ACCESS_BACKEND=qwen-funccall
ACCESS_MODEL_KEY=access-model-tbd

# ACCESS_MODEL_PATH=/path/to/qwen-access-model