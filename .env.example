# ============================================================
# ITSM Agent
#
# Canonical environment template.
# Copy values you need into the ignored .env file.
# Never commit real credentials.
# ============================================================


# ============================================================
# AI SERVICE
# ============================================================

AI_HOST=127.0.0.1
AI_PORT=8000


# ============================================================
# DURABLE APPROVAL STORE
# ============================================================

APPROVAL_STORE_PATH=.runtime/approvals.sqlite3


# ============================================================
# PROCESS EXECUTION WORKSPACE
# ============================================================

# Defaults to the AI repository root when omitted.
# PROCESS_WORKSPACE_ROOT=/path/to/approved/workspace


# ============================================================
# AGENT DEFINITIONS
# ============================================================

AGENTS_DIR=./subagents/agents


# ============================================================
# HUB
# ============================================================

HUB_BACKEND=ministral

HUB_MODEL_PATH=/path/to/Ministral-3-3B-Instruct-2512

# Required on GPUs such as RTX 4050 / compute capability 8.9.
HUB_DEQUANTIZE_FP8=true

# Optional.
# HUB_OFFLOAD_FOLDER=/path/to/offload


# ============================================================
# ACCOUNT SPECIALIST
# ============================================================

ACCOUNT_BACKEND=qwen-funccall
ACCOUNT_MODEL_KEY=qwen2.5-0.5b-funccall
ACCOUNT_MODEL_PATH=/path/to/qwen2.5-0.5b-funccall


# ============================================================
# ACCESS SPECIALIST
# ============================================================

ACCESS_ENABLED=false

ACCESS_BACKEND=qwen3
ACCESS_MODEL_KEY=qwen3-0.6b

# Required when ACCESS_ENABLED=true.
# ACCESS_MODEL_PATH=/path/to/qwen3-0.6b


# ============================================================
# DEVELOPER SPECIALIST
# ============================================================

DEVELOPER_ENABLED=true

DEVELOPER_BACKEND=qwen-coder
DEVELOPER_MODEL_KEY=qwen2.5-coder-0.5b

# DEVELOPER_MODEL_PATH=/path/to/Qwen2.5-Coder-0.5B-Instruct


# ============================================================
# DIRECTORY PROVIDER
# ============================================================

# mock | ldap
DIRECTORY_BACKEND=mock


# ============================================================
# LOCAL SAMBA AD DEVELOPMENT
# ============================================================

SAMBA_DOMAIN=ITSM
SAMBA_REALM=itsm.local
SAMBA_NETBIOS=ITSMDC

# Supply a local-development password in .env.
SAMBA_ADMIN_PASS=


# ============================================================
# LDAP / ACTIVE DIRECTORY
# ============================================================

AD_HOST=127.0.0.1
AD_PORT=1636
AD_USE_SSL=true

AD_BASE_DN=DC=itsm,DC=local


# ------------------------------------------------------------
# Read-only bind
#
# Either AD_BIND_USER or AD_BIND_DN may be used.
# ------------------------------------------------------------

AD_BIND_USER=
AD_BIND_DN=
AD_BIND_PASSWORD=


# ------------------------------------------------------------
# Write / mutation bind
#
# Either AD_WRITE_BIND_USER or AD_WRITE_BIND_DN may be used.
# ------------------------------------------------------------

AD_WRITE_BIND_USER=
AD_WRITE_BIND_DN=
AD_WRITE_BIND_PASSWORD=


# ------------------------------------------------------------
# Integration/preflight identity
# ------------------------------------------------------------

AD_TEST_USER=jdoe


# ------------------------------------------------------------
# Logical resource -> AD group mapping
# ------------------------------------------------------------

AD_ACCESS_GROUPS={"vpn":"VPN-Users","admin":"ITSM-Admins"}